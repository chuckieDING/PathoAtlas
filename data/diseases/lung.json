  {"id":"lung-adenocarcinoma","nameZh":"肺腺癌","nameEn":"Lung Adenocarcinoma","aliases":["腺癌"],"organ":"lung","category":"malignant","epidemiology":"最常见的肺癌类型(40-50%)，与吸烟相关但也见于非吸烟者。","clinicalFeatures":"周围型多见，早期无症状，进展后咳嗽、胸痛、咯血。","grossPathology":"肺周围灰白色结节，边界不清，可伴胸膜凹陷征。","microscopy":"五种主要亚型：贴壁型、腺泡型、乳头型、微乳头型、实性型。","keyFeatures":["WHO五种主要亚型","TTF-1+/Napsin A+","EGFR/ALK/ROS1驱动基因突变","PD-L1指导免疫治疗"],"ihcProfile":[{"marker":"TTF-1","result":"阳性(80%)","note":"肺腺癌敏感标记"},{"marker":"Napsin A","result":"阳性(70-80%)","note":"特异标记"},{"marker":"CK7","result":"阳性","note":""},{"marker":"CK20","result":"阴性","note":"CK7+/CK20-"},{"marker":"p40","result":"阴性","note":"排除鳞癌"}],"molecularFeatures":"EGFR突变率约50%(东亚)，ALK融合约5%，ROS1约1-2%，KRAS约30%。","differentialDiagnosis":["lung-squamous-cell-carcinoma","mesothelioma"],"grading":"WHO 2021分级1-3级","staging":"AJCC TNM第8版","prognosis":"IA期>90%，IV期有靶向治疗中位>3年。","treatment":"早期手术；晚期靶向(EGFR-TKI/ALK抑制剂)、免疫(PD-1)或化疗。","images":[],"references":["WHO Thoracic Tumours, 5th Ed, 2021"]},
  {"id":"lung-squamous-cell-carcinoma","nameZh":"肺鳞状细胞癌","nameEn":"Lung Squamous Cell Carcinoma","aliases":["鳞癌","SCC"],"organ":"lung","category":"malignant","epidemiology":"约占肺癌25-30%，与重度吸烟密切相关。","clinicalFeatures":"中央型多见，可引起阻塞性肺炎。","grossPathology":"中央型灰白色肿块，常伴坏死空洞。","microscopy":"鳞状分化，可见角化珠和细胞间桥。","keyFeatures":["鳞状分化(角化/细胞间桥)","p40+/p63+/CK5/6+","TTF-1阴性","中央型，与吸烟强相关"],"ihcProfile":[{"marker":"p40","result":"阳性","note":"最特异鳞癌标记"},{"marker":"p63","result":"阳性","note":""},{"marker":"CK5/6","result":"阳性","note":""},{"marker":"TTF-1","result":"阴性","note":"区别于腺癌"}],"molecularFeatures":"TP53突变率>80%，FGFR1扩增约20%。","differentialDiagnosis":["lung-adenocarcinoma","small-cell-lung-carcinoma"],"grading":"高/中/低分化","staging":"AJCC TNM第8版","prognosis":"预后较腺癌差。","treatment":"手术、放化疗为主，免疫治疗效果好。","images":[],"references":["WHO Thoracic Tumours, 5th Ed, 2021"]},
  {"id":"small-cell-lung-carcinoma","nameZh":"小细胞肺癌","nameEn":"Small Cell Lung Carcinoma","aliases":["SCLC"],"organ":"lung","category":"malignant","epidemiology":"约占肺癌13-15%，几乎均与重度吸烟有关。","clinicalFeatures":"中央型，进展迅速，早期广泛转移，可伴副肿瘤综合征。","grossPathology":"灰白色软性肿物，广泛坏死。","microscopy":"小至中等大小细胞密集排列，核染色质细腻，核仁不明显，核分裂象极多。","keyFeatures":["小细胞，核染色质细腻","神经内分泌标记阳性(Syn/CgA/CD56)","Ki-67>80%","TP53和RB1双失活"],"ihcProfile":[{"marker":"Synaptophysin","result":"阳性","note":""},{"marker":"Chromogranin A","result":"阳性(70%)","note":""},{"marker":"CD56","result":"阳性","note":"最敏感NE标记"},{"marker":"TTF-1","result":"阳性(85%)","note":""},{"marker":"Ki-67","result":">80%","note":"极高增殖"}],"molecularFeatures":"TP53+RB1双失活(近100%)。DLL3表达可作为ADC靶点。","differentialDiagnosis":["lung-adenocarcinoma","carcinoid-tumor"],"grading":"不分级，均为高级别","staging":"局限期/广泛期","prognosis":"预后极差，局限期中位15-20月。","treatment":"化疗(EP方案)+放疗，免疫治疗已纳入一线。","images":[],"references":["WHO Thoracic Tumours, 5th Ed, 2021"]},
  {"id":"mesothelioma","nameZh":"恶性胸膜间皮瘤","nameEn":"Malignant Pleural Mesothelioma","aliases":["间皮瘤"],"organ":"lung","category":"malignant","epidemiology":"与石棉暴露密切相关，潜伏期20-40年。","clinicalFeatures":"胸腔积液、胸痛、呼吸困难，胸膜弥漫增厚。","grossPathology":"胸膜弥漫增厚呈盔甲样。","microscopy":"上皮样型(最常见)、肉瘤样型、双相型。","keyFeatures":["胸膜弥漫增厚","石棉暴露史","Calretinin+/WT1+/D2-40+","需与肺腺癌胸膜转移鉴别"],"ihcProfile":[{"marker":"Calretinin","result":"阳性","note":"间皮标记"},{"marker":"WT1","result":"阳性(核)","note":""},{"marker":"D2-40","result":"阳性","note":""},{"marker":"CEA","result":"阴性","note":"区别于腺癌"},{"marker":"TTF-1","result":"阴性","note":"排除肺腺癌"}],"molecularFeatures":"BAP1缺失，CDKN2A纯合缺失(p16 FISH)。","differentialDiagnosis":["lung-adenocarcinoma"],"grading":"上皮样/双相/肉瘤样","staging":"AJCC TNM","prognosis":"中位生存12-18月。","treatment":"手术+化疗(培美曲塞+铂类)+免疫治疗。","images":[],"references":["WHO Thoracic Tumours, 5th Ed, 2021"]}
