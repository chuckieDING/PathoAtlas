# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime data (seeded from data/ on first run, preserved across deployments)
/data-runtime
# per-user data should never be committed
/data/users
# audit log is runtime-generated
/data/audit-log.jsonl

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Enhancement pipeline outputs (re-derivable from data/)
docs/enhancement-results/
docs/enhancement-tasks.json
docs/enhancement-plan.json
docs/review-queue.md
docs/review-rejections.txt

# Runtime data + backups (seeded from data/ on first run)
data-runtime/backups/

# Python bytecode + script logs
**/__pycache__/
*.pyc
scripts/enhance/*.log

# Pending-resources auditor outputs (re-derivable)
docs/pending-resources.md
docs/pending-resources.json

# i18n auditor outputs (re-derivable)
docs/i18n-audit.md
docs/i18n-audit.json
